# Generate a different value for every deployment, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# Independently generated HMAC key for protected email verification and reset
# token digests. Production refuses to reuse SECRET_KEY for this purpose.
ACCOUNT_TOKEN_PEPPER=replace-with-a-different-long-random-secret

# Use "production" in deployed environments. Production startup refuses
# insecure browser cookies.
APP_ENV=development

# Local HTTP development only. Production requires this to be true.
BROWSER_COOKIE_SECURE=0

# Rate limits use process-local memory only for development/tests. Production
# must use a shared Redis URI (redis:// or rediss://) and a stable, dedicated
# HMAC secret generated independently from SECRET_KEY.
RATELIMIT_STORAGE_URI=memory://
RATE_LIMIT_KEY_SECRET=replace-with-another-long-random-secret
RATELIMIT_KEY_PREFIX=secure-share

# SQLite is convenient for local development. Production can use a
# PostgreSQL URL such as postgresql+psycopg://user:password@host/database.
DATABASE_URL=sqlite:///secure_share.db

# Keep this outside any directory served by a web server.
UPLOAD_FOLDER=storage

# Maximum request size in bytes (default shown: 16 MiB).
MAX_CONTENT_LENGTH=16777216

# Lifetime of server-side bearer and browser sessions (default: 24 hours).
SESSION_LIFETIME_SECONDS=86400

# Expiring, single-use account-action links.
EMAIL_VERIFICATION_TOKEN_LIFETIME_SECONDS=86400
PASSWORD_RESET_TOKEN_LIFETIME_SECONDS=3600
# Response-time floor reduces account-enumeration timing differences.
PASSWORD_RESET_MINIMUM_RESPONSE_SECONDS=0.5
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Development writes private .eml messages under instance/mail-outbox. Set
# MAIL_BACKEND=smtp and PUBLIC_BASE_URL=https://... in production.
MAIL_BACKEND=file
MAIL_FROM_ADDRESS=no-reply@secure-share.local
MAIL_FILE_OUTBOX=mail-outbox
# Local file/memory delivery may run inline. Production must set this to 0 and
# run `flask --app run.py email-worker` as a separate long-lived process.
SECURITY_EMAIL_INLINE_DELIVERY=1
SECURITY_EMAIL_LEASE_SECONDS=300
SECURITY_EMAIL_MAX_ATTEMPTS=5
SECURITY_EMAIL_RETRY_BASE_SECONDS=30
SECURITY_EMAIL_RETRY_MAX_SECONDS=3600
SECURITY_EMAIL_WORKER_BATCH_SIZE=100
SECURITY_EMAIL_WORKER_POLL_SECONDS=2
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Production requires exactly one of SSL or STARTTLS.
# SMTP_USE_SSL=0
# SMTP_USE_STARTTLS=1
# SMTP_TIMEOUT_SECONDS=10

# Extra compromised-password blocklist. The bundled development safeguards
# always apply; production additionally requires at least 10,000 unique
# SHA-256 digests here. Never put raw passwords in this file. Relative paths
# are resolved from the project root.
# PASSWORD_BLOCKLIST_PATH=/etc/secure-share/compromised-passwords.sha256

# Development only. Do not enable debug mode in production.
FLASK_DEBUG=0
